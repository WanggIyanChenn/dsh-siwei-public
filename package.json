{
  "name": "dsh-siwei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A read-only board for staged writing pipelines: stage ledgers, artifacts and next steps in one sidebar panel.",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "gallery",
    "cordis.patch.yml.example",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "displayName": "Siwei",
    "description": "Stage ledgers, artifacts and next steps for staged writing pipelines, in one sidebar panel.",
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Siwei contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WanggIyanChenn/dsh-siwei-public.git"
  }
}
